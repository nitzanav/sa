# RDS. sslmode=require encrypts the session. The alert-bot image trusts the
# Amazon RDS CA (NODE_EXTRA_CA_CERTS and PGSSLROOTCERT) so Node's pg driver
# can verify the server. The RDS security group must allow the Docker host.
DATABASE_URL=postgresql://myuser:secret@mydb.xxxx.us-east-1.rds.amazonaws.com:5432/mydb?sslmode=require
ALERT_EMAIL=you@example.com
# TIP_RANKS_API_KEY=
# Live scrapes need this. Cache hits do not.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Docker notify_alerts sends through msmtp when SMTP_HOST is set.
# GIT_PAT=
# GitHub personal access token with repo scope. Not an SSH key.
# The alert-bot image clones and pushes over HTTPS with this token.
